# Out-of-tree Kbuild for the A21s S2MU106 minimal charger driver.
#
# Build (from repo root, after bootstrap_build_env.sh):
#   make -C src/linux O=../../build/linux ARCH=arm64 LLVM=1 \
#        M=$PWD/drivers/s2mu106 modules
#
# Deploy: copy s2mu106-charger.ko to /usr/lib/modules/$(uname -r)/extra/
# on the A21s rootfs (never /lib - see AGENTS.md), then instantiate via
#   echo s2mu106-charger 0x3d > /sys/bus/i2c/devices/i2c-0/new_device
# or bind it through the DT node once patches/linux carries it.

ccflags-y += -I$(src)

obj-m += s2mu106-charger.o
