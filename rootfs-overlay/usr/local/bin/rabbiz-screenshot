#!/usr/bin/env bash
set -euo pipefail

RABBIZ_USER="rabbiz"
RABBIZ_UID="$(id -u "${RABBIZ_USER}" 2>/dev/null || echo 1001)"

# Never touch user-owned /run/user/<uid> or ~/Pictures paths as root (SVC-001).
if [ "$(id -u)" -eq 0 ]; then
    exec runuser -u "${RABBIZ_USER}" -- env \
        XDG_RUNTIME_DIR="/run/user/${RABBIZ_UID}" \
        HOME="/home/${RABBIZ_USER}" \
        "$0" "$@"
fi

DELAY_MS=0
while [ $# -gt 0 ]; do
    case "$1" in
        --delay)
            DELAY_MS="${2:-0}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${RABBIZ_UID}}"
WAYLAND_SOCK="${WAYLAND_DISPLAY:-wayland-0}"
if [ ! -S "${RUNTIME_DIR}/${WAYLAND_SOCK}" ]; then
    found_sock="$(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'wayland-[0-9]*' 2>/dev/null | head -n1 || true)"
    if [ -n "${found_sock}" ]; then
        WAYLAND_SOCK="$(basename "${found_sock}")"
    fi
fi

SCREENSHOT_DIR="/home/${RABBIZ_USER}/Pictures/Screenshots"
STATE_FILE="${RUNTIME_DIR}/a21s-screenshot.state"

if [ "${DELAY_MS}" -gt 0 ] 2>/dev/null; then
    sleep_sec="$(awk -v ms="${DELAY_MS}" 'BEGIN { printf "%.3f", ms / 1000.0 }')"
    sleep "${sleep_sec}"
fi

mkdir -p "${SCREENSHOT_DIR}" "${RUNTIME_DIR}" 2>/dev/null || true

STAMP="$(date +%Y%m%d_%H%M%S)"
FILENAME="Screenshot_${STAMP}.png"
OUT_PATH="${SCREENSHOT_DIR}/${FILENAME}"
if [ -e "${OUT_PATH}" ]; then
    MS="$(date +%3N 2>/dev/null || echo $$)"
    FILENAME="Screenshot_${STAMP}_${MS}.png"
    OUT_PATH="${SCREENSHOT_DIR}/${FILENAME}"
fi

env \
    XDG_RUNTIME_DIR="${RUNTIME_DIR}" \
    WAYLAND_DISPLAY="${WAYLAND_SOCK}" \
    grim "${OUT_PATH}"

chmod 644 "${OUT_PATH}" 2>/dev/null || true

NONCE="$(date +%s%N 2>/dev/null || date +%s)-$$"
TMP_STATE="$(mktemp "${STATE_FILE}.tmp.XXXXXX")"
printf '%s|%s|%s\n' "${OUT_PATH}" "${FILENAME}" "${NONCE}" > "${TMP_STATE}"
mv -f "${TMP_STATE}" "${STATE_FILE}"

printf '%s\n' "${OUT_PATH}"
