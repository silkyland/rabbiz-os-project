#!/bin/sh
# rabbiz-settings — launch the rabbiz-shell Settings app via quickshell (services need
# Quickshell.Io / Quickshell.Services — plain qml6 cannot load them).
# Deployed to /usr/local/bin/ by scripts/deploy_shell.sh, which sets +x.
export QML_IMPORT_PATH=/usr/share/rabbiz-shell
exec a21s-qt-render quickshell -p /usr/share/rabbiz-shell/apps/settings/Settings.qml "$@"
