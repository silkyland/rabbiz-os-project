#!/bin/sh
# a21s-steam — Steam Big Picture inside labwc via XWayland (default) or gamescope.
#
# Launching directly on labwc's built-in XWayland (DISPLAY=:0) avoids nested
# gamescope's dmabuf import issue on exynos-drm (no IOMMU on card0). Pass
# `--gamescope` to opt into nested gamescope explicitly.
#
# Deployed to /usr/local/bin/ by scripts/deploy_shell.sh, which sets +x.

export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
export STEAMOS=1
export STEAM_RUNTIME=0
export DBUS_FATAL_WARNINGS=0
export LD_LIBRARY_PATH="/home/gamer/.local/share/Steam/steamrtarm64:/home/gamer/.local/share/Steam/steamrtarm64/libs:/home/gamer/.local/share/Steam/steamrtarm64/video${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

STEAM_BIN="/home/gamer/.local/share/Steam/steamrtarm64/steam"
if [ ! -x "$STEAM_BIN" ]; then
    STEAM_BIN="steam"
fi

STEAM_ARGS="-noverifyfiles -nobootstrapupdate -skipinitialbootstrap -gamepadui -no-cef-sandbox -cef-disable-gpu -cef-disable-gpu-compositing"

if [ "${1:-}" = "--gamescope" ]; then
    shift
    exec gamescope -W 720 -H 1600 -f -e -- \
        env SDL_VIDEODRIVER=x11 "$STEAM_BIN" $STEAM_ARGS "$@"
fi

export DISPLAY="${DISPLAY:-:0}"
unset SDL_VIDEODRIVER
exec "$STEAM_BIN" $STEAM_ARGS "$@"
