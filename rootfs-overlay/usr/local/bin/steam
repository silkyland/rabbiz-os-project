#!/bin/sh
# /usr/local/bin/steam — phone-shell shim.
#
# Desktop entries generated by Steam (e.g. "Bit Blaster XL" ->
# `steam steam://rungameid/433950`) call this from inside the phone
# session. The args are stashed for steamos-session to replay, then the
# seat is handed to the SteamOS session. Inside that session (marker
# file present) this shim execs the real client directly.
RD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -f "$RD/a21s-in-steam" ]; then
    exec /home/gamer/.local/share/Steam/steamrtarm64/steam "$@"
fi
printf '%s\n' "$*" > "$RD/a21s-steam-args" 2>/dev/null
exec a21s-session-switch steamos
