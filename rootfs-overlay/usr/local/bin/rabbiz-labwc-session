#!/usr/bin/env bash
# rabbiz-labwc-session — session entrypoint for the rabbiz-shell phone DE.
#
# Started by rabbiz-session.service as user `gamer`. Sets the Wayland
# session environment, creates XDG dirs, then exec()s labwc as the session
# leader (labwc claims DRM + input through seatd — no VT/TTY needed).
#
# Deployed to /usr/local/bin/ by scripts/deploy_shell.sh, which sets +x.

set -euo pipefail

# --- XDG base dirs -------------------------------------------------------
export LANG="${LANG:-C.UTF-8}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
# One-time rename migration: ~/.config/a21s-shell → ~/.config/rabbiz-shell
# (prefs.json, desktop.json user data). Runs on every session start; no-op
# once the old dir is gone or the new one exists.
if [ -d "$XDG_CONFIG_HOME/a21s-shell" ] && [ ! -e "$XDG_CONFIG_HOME/rabbiz-shell" ]; then
    mv "$XDG_CONFIG_HOME/a21s-shell" "$XDG_CONFIG_HOME/rabbiz-shell"
fi
# Base-app data dirs went a21s-* → rabbiz-* in the same rename.
for d in calculator clock notes terminal; do
    if [ -d "$XDG_DATA_HOME/a21s-$d" ] && [ ! -e "$XDG_DATA_HOME/rabbiz-$d" ]; then
        mv "$XDG_DATA_HOME/a21s-$d" "$XDG_DATA_HOME/rabbiz-$d"
    fi
done
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$XDG_CONFIG_HOME/rabbiz-shell"
if [ ! -f "$XDG_CONFIG_HOME/rabbiz-shell/prefs.json" ]; then
    printf '{}\n' > "$XDG_CONFIG_HOME/rabbiz-shell/prefs.json"
fi
if [ ! -f "$XDG_RUNTIME_DIR/a21s-power.cmd" ]; then
    printf 'idle:0\n' > "$XDG_RUNTIME_DIR/a21s-power.cmd"
fi

# --- Session identity ----------------------------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=rabbiz-shell
export XDG_CURRENT_DESKTOP=labwc

# --- Compositor/seat -----------------------------------------------------
export LIBSEAT_BACKEND=seatd
export WLR_RENDERER="${WLR_RENDERER:-gles2}"   # Mali-G52/Panfrost: GLES only
# Bind strictly to exynos-drm (DSI-1) so wlroots ignores simpledrm (card1).
if [ -e /dev/dri/by-path/platform-exynos-drm-card ]; then
    export WLR_DRM_DEVICES="$(readlink -f /dev/dri/by-path/platform-exynos-drm-card)"
elif [ -e /dev/dri/card0 ]; then
    export WLR_DRM_DEVICES=/dev/dri/card0
fi

# --- Toolkit env (inherited by quickshell, qml6 apps, gamescope) -----------
export QT_QPA_PLATFORM=wayland
export QT_QUICK_BACKEND=software
export QT_QUICK_CONTROLS_MOBILE=1
export QT_SCALE_FACTOR=1
export QT_QPA_PLATFORMTHEME=kde                # desktop contract: Qt/KDE apps follow kdeglobals (the shell opts out in labwc autostart)
export PLASMA_PLATFORM=phone:handset
export QML_IMPORT_PATH="${QML_IMPORT_PATH:-/usr/share/rabbiz-shell}"
export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:-/usr/share/rabbiz-shell}"
export MOZ_ENABLE_WAYLAND=1
export SDL_VIDEODRIVER=wayland

# --- Start compositor (session leader) -----------------------------------
# CMA leak fix (devices/samsung/a21s/docs/FINDINGS-hw-render.md F2): Mesa kmsro frees imported buffers with DESTROY_DUMB on the
# exynos render node, which the kernel refuses; the shim retries as GEM_CLOSE. Compositor only.
[ -r /usr/local/lib/a21s-qt-scanout/dumb-destroy.so ] && export LD_PRELOAD="/usr/local/lib/a21s-qt-scanout/dumb-destroy.so${LD_PRELOAD:+:$LD_PRELOAD}"
exec /usr/bin/labwc
