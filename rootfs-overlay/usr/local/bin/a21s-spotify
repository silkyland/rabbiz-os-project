#!/bin/sh
export QML_IMPORT_PATH="/usr/share/a21s-shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"

# Ensure Spotify Connect receiver ("Galaxy A21s") is running on the session audio bus
if command -v a21s-spotify-ctl >/dev/null 2>&1; then
    a21s-spotify-ctl start-connect >/dev/null 2>&1 &
fi

exec quickshell -p /usr/share/a21s-shell/apps/spotify/Spotify.qml "$@"
