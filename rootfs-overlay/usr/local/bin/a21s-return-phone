#!/bin/sh
# a21s-return-phone — steamos-session.service ExecStopPost hook.
# If the steam session was entered via a21s-session-switch (marker file),
# hand the seat back to the phone shell. Also covers weston/steam
# crashing outright (ExecStopPost runs on failure too, unit Restart=no).
FLAG=/run/user/1001/a21s-in-steam
if [ -f "$FLAG" ]; then
    rm -f "$FLAG"
    systemctl --no-block start a21s-phone-session.service 2>/dev/null || true
fi
exit 0
