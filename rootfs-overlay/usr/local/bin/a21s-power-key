#!/bin/sh
# Handle hardware Power key (XF86PowerOff), biometric fingerprint unlock events,
# and CLI lock/sleep/wake requests for a21s-shell. Sends atomic command
# triggers to SystemControl.qml via /run/user/<uid>/a21s-power.cmd, with a
# direct backlight failsafe when quickshell is not running.
set -eu

ACTION="${1:-toggle}"
case "$ACTION" in
  toggle|sleep|wake|lock|menu|fp-unlock|fp-fail) ;;
  *)
    echo "Usage: $0 [toggle|sleep|wake|lock|menu|fp-unlock|fp-fail]" >&2
    exit 1
    ;;
esac

if [ "$ACTION" = "fp-unlock" ] && [ -w /sys/kernel/a21s_fp/trigger_unlock ]; then
  printf '1\n' > /sys/kernel/a21s_fp/trigger_unlock 2>/dev/null || true
fi

GAMER_UID="$(id -u gamer 2>/dev/null || echo 1001)"
RUNTIME_DIR="/run/user/${GAMER_UID}"
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true

# Power + Volume Up/Down is the screenshot combo (volume-keys.py). The Power press arrives first or
# second, so wait one combo window and drop the toggle if a volume key was pressed around it.
if [ "$ACTION" = "toggle" ]; then
  sleep 0.3
  if [ -e "${RUNTIME_DIR}/a21s-key-combo" ]; then
    age_ms=$(awk -v n="$(date +%s.%N)" -v m="$(stat -c %.3Y "${RUNTIME_DIR}/a21s-key-combo")" 'BEGIN{printf "%d", (n-m)*1000}')
    [ "$age_ms" -le 800 ] && exit 0
  fi
fi

CMD_FILE="${RUNTIME_DIR}/a21s-power.cmd"
NONCE="$(date +%s%N 2>/dev/null || date +%s)-$$"

printf '%s:%s\n' "$ACTION" "$NONCE" > "$CMD_FILE"
if [ "$(id -u)" -eq 0 ]; then
  chown gamer:gamer "$CMD_FILE" 2>/dev/null || true
  chmod 664 "$CMD_FILE" 2>/dev/null || true
fi

# Failsafe hardware wake/sleep only if quickshell is not running; when
# quickshell is active, SystemControl.qml owns brightness save/restore.
if ! pgrep -x quickshell >/dev/null 2>&1; then
  for bl in /sys/class/backlight/*; do
    [ -d "$bl" ] || continue
    case "$ACTION" in
      sleep)
        cat "$bl/brightness" > "${RUNTIME_DIR}/a21s-saved-brightness" 2>/dev/null || true
        echo 0 > "$bl/brightness" 2>/dev/null || true
        echo 4 > "$bl/bl_power" 2>/dev/null || true
        ;;
      wake|toggle|fp-unlock)
        echo 0 > "$bl/bl_power" 2>/dev/null || true
        if [ -s "${RUNTIME_DIR}/a21s-saved-brightness" ]; then
          cat "${RUNTIME_DIR}/a21s-saved-brightness" > "$bl/brightness" 2>/dev/null || true
        elif [ "$(cat "$bl/brightness" 2>/dev/null || echo 0)" -eq 0 ]; then
          echo 180 > "$bl/brightness" 2>/dev/null || true
        fi
        ;;
    esac
  done
fi
