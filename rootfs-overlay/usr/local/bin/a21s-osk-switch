#!/bin/sh
# Switch the A21s on-screen keyboard between the shipped squeekboard (default) and a21s-osk.
# Run as root:  a21s-osk-switch start|stop|status
#
# Only one input method may own the seat, so `start` kills squeekboard first and waits for it to
# disappear; `stop` restores squeekboard. The session autostart keeps squeekboard, so a reboot
# always returns to the known-good keyboard.
set -eu

GAMER_UID="$(id -u gamer)"
RUNTIME="/run/user/${GAMER_UID}"
LOG="/tmp/a21s-osk.log"

# `setsid` needs a real program, not a shell function, so the env is spelled out where we detach.
as_gamer() {
  runuser -u gamer -- env \
    XDG_RUNTIME_DIR="$RUNTIME" \
    WAYLAND_DISPLAY=wayland-0 \
    DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/bus" \
    "$@"
}

wait_gone() {
  name="$1"
  i=0
  while pgrep -x "$name" >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -gt 60 ] && return 1
    sleep 0.1
  done
  return 0
}

case "${1:-status}" in
  start)
    pkill -x squeekboard 2>/dev/null || true
    wait_gone squeekboard || { echo "squeekboard will not exit" >&2; exit 1; }
    if pgrep -x a21s-osk >/dev/null 2>&1; then
      echo "a21s-osk is already running"
      exit 0
    fi
    setsid runuser -u gamer -- env \
      XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=wayland-0 \
      DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/bus" \
      /usr/local/bin/a21s-osk >"$LOG" 2>&1 &
    sleep 1.5
    if pgrep -x a21s-osk >/dev/null 2>&1; then
      echo "a21s-osk running (log: $LOG)"
      tail -n 2 "$LOG" 2>/dev/null || true
    else
      echo "a21s-osk failed to start:" >&2
      cat "$LOG" >&2
      exit 1
    fi
    ;;
  stop)
    pkill -x a21s-osk 2>/dev/null || true
    wait_gone a21s-osk || true
    if ! pgrep -x squeekboard >/dev/null 2>&1; then
      setsid runuser -u gamer -- env \
        XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=wayland-0 \
        DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/bus" \
        squeekboard >/dev/null 2>&1 &
      sleep 1
    fi
    pgrep -ax squeekboard | head -n 1 || { echo "squeekboard did not start" >&2; exit 1; }
    ;;
  status)
    sq=$(pgrep -x squeekboard | head -n 1 || true)
    osk=$(pgrep -x a21s-osk | head -n 1 || true)
    echo "squeekboard: ${sq:-stopped}"
    echo "a21s-osk:    ${osk:-stopped}"
    ;;
  *)
    echo "usage: $0 start|stop|status" >&2
    exit 2
    ;;
esac
