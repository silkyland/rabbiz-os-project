#!/bin/bash
# rabbiz-wifi-connect — join a Wi-Fi network without exposing the PSK in argv.
#
# usage: rabbiz-wifi-connect <SSID>          # WPA PSK on stdin (empty line = open network)
#
# Why a helper: `nmcli device wifi connect SSID password <psk>` leaves the secret in
# /proc/<pid>/cmdline for the whole connect. Here the PSK arrives on stdin and nmcli
# reads it from a pty prompt (`--ask`), echoed off; it never appears in an argument list.
# A keyfile would be cleaner but NetworkManager's `connection load` is root-only
# regardless of polkit (verified: "failed to load connection: access denied").
#
# Requires rootfs-overlay/etc/polkit-1/rules.d/51-rabbiz-shell.rules: without it nmcli
# answers "Insufficient privileges" because labwc has no polkit auth agent.
set -u

SSID="${1:-}"
[ -n "$SSID" ] || { echo "Error: missing SSID" >&2; exit 2; }
IFS= read -r PSK || PSK=""

# Run nmcli --ask in a pty with ECHO disabled before exec so the PSK never
# appears in argv, never hits a sleep/echo race (PRIV-006), and never passes
# through shell string interpolation (SVC-003).
ask() {
    printf '%s\n' "$PSK" | timeout 45 python3 -c '
import os, pty, select, subprocess, sys, termios

psk = sys.stdin.readline()
argv = ["nmcli", "--ask", *sys.argv[1:]]
master_fd, slave_fd = pty.openpty()
try:
    attrs = termios.tcgetattr(slave_fd)
    attrs[3] &= ~termios.ECHO
    termios.tcsetattr(slave_fd, termios.TCSANOW, attrs)

    proc = subprocess.Popen(
        argv,
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        close_fds=True,
    )
    os.close(slave_fd)
    slave_fd = -1

    sent = False
    buf = b""
    while True:
        r, _, _ = select.select([master_fd], [], [], 0.25)
        if master_fd in r:
            try:
                chunk = os.read(master_fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            if not sent and (b":" in buf or b"?" in buf):
                os.write(master_fd, psk.encode("utf-8"))
                sent = True
        if proc.poll() is not None:
            break
    sys.exit(proc.wait())
finally:
    if slave_fd >= 0:
        os.close(slave_fd)
    os.close(master_fd)
' "$@"
}

# 1) Find an existing profile for this SSID: `nmcli device wifi connect` otherwise
#    creates "SSID 1", "SSID 2"... on every join.
PROFILE=""
while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ "$(nmcli -t -g 802-11-wireless.ssid connection show id "$name" 2>/dev/null)" = "$SSID" ]; then
        PROFILE="$name"
        break
    fi
done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null \
    | awk -F: '$2 == "802-11-wireless" { print $1 }')

if [ -n "$PROFILE" ]; then
    if [ -n "$PSK" ]; then
        ask connection modify id "$PROFILE" wifi-sec.psk || true
    fi
    exec timeout 40 nmcli connection up id "$PROFILE"
fi

# 2) No profile yet. Bind to wlan0: without `ifname`, NetworkManager picks p2p0 (its
#    P2P device) and fails with "association took too long / ssid-not-found".
nmcli device wifi rescan >/dev/null 2>&1 || true   # a radio toggle empties the list
sleep 1
ask device wifi connect "$SSID" ifname wlan0
