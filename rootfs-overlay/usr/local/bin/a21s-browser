#!/bin/sh
# a21s-browser — launch Google Chrome in the a21s phone session (labwc/Wayland)
# NOTE: exynos-drm cannot import non-contiguous dmabufs; Chromes GBM/dmabuf
# path is fatal on wlroots (compositor kills the client). With the stock Mesa that still holds, so the
# stock fallback keeps --disable-gpu. Through a21s-qt-gpu (scanout-patched Mesa + primary-node shim,
# devices/samsung/a21s/docs/a21s-qt-gpu-scanout.md) Chrome renders on Panfrost (ANGLE GLES) -- verified 2026-11-16 -- but
# Chrome's GPU path drained CMA from 197 MiB to 16 MiB within 15 s of start and exited clients leak CMA
# (devices/samsung/a21s/docs/FINDINGS-hw-render.md F2/F3), so GPU is OPT-IN: A21S_BROWSER_GPU=1 a21s-browser.
# --disable-component-update: stop Chrome pulling 100-300MB of on-device ML
# components (OptimizationGuide TFLite, WasmTtsEngine) onto the nearly-full /.
export MOZ_ENABLE_WAYLAND=1
floor_kb=${A21S_CMA_FLOOR_KB:-131072}
free_kb=$(awk '/^CmaFree:/{print $2}' /proc/meminfo)
if [ "${A21S_BROWSER_GPU:-0}" = 1 ] && [ "${A21S_FORCE_SOFTWARE:-0}" != 1 ] && [ "${free_kb:-0}" -ge "$floor_kb" ] && a21s-qt-gpu --check 2>/dev/null; then
    set -- --use-gl=angle --use-angle=gles "$@"
    chrome="a21s-qt-gpu /opt/google/chrome/google-chrome"
else
    set -- --disable-gpu "$@"
    chrome="/opt/google/chrome/google-chrome"
fi
exec $chrome \
    --ozone-platform=wayland \
    --no-first-run \
    --no-default-browser-check \
    --touch-events=enabled \
    --enable-pinch \
    --force-device-scale-factor=1.5 \
    --disable-component-update \
    --password-store=basic \
    "$@"
