#!/usr/bin/python3
# rabbiz-splash — paint the RabbizOS wordmark on the framebuffer instead of the verbose boot console.
# Input: a top-down 32-bpp BMP (BGRA, BITFIELDS) made from assets/branding/rabbizos-wordmark-on-cream.png.
# The first pixel is the background colour; the image is centred on a full-screen fill of it.
# Runs early (rabbiz-splash.service); labwc takes the display over later. Never fails the boot.
import mmap, os, struct, sys, time

BMP = "/usr/share/rabbiz/rabbizos-splash.bmp"
FB = "/dev/fb0"
SYS = "/sys/class/graphics/fb0/"

def rd(name):
    with open(SYS + name) as f:
        return f.read().strip()

def main():
    for _ in range(50):                       # wait up to 5 s for the exynos-drm fbdev
        if os.path.exists(FB) and os.path.exists(SYS + "virtual_size"):
            break
        time.sleep(0.1)
    else:
        return 0
    fw, fh = map(int, rd("virtual_size").split(","))
    bpp, stride = int(rd("bits_per_pixel")), int(rd("stride"))
    if bpp != 32:
        return 0
    d = open(BMP, "rb").read()
    off = struct.unpack_from("<I", d, 10)[0]
    w, h, _planes, ibpp = struct.unpack_from("<iiHH", d, 18)
    if ibpp != 32 or h >= 0:
        return 0                              # only top-down 32-bpp supported
    h = -h
    bg = d[off:off + 4]
    x0, y0 = (fw - w) // 2, (fh - h) // 2
    with open(FB, "r+b") as f:
        m = mmap.mmap(f.fileno(), stride * fh)
        m[0:stride * fh] = bg * (stride * fh // 4)
        for y in range(h):
            row = d[off + y * w * 4: off + (y + 1) * w * 4]
            p = (y0 + y) * stride + x0 * 4
            m[p:p + w * 4] = row
        m.close()
    return 0

try:
    sys.exit(main())
except Exception as e:                        # a splash must never block boot
    print("rabbiz-splash:", e, file=sys.stderr)
    sys.exit(0)
