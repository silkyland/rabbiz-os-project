#!/usr/bin/env bash
# rabbiz-session — session selector for the A21s phone session (M1-T6).
#
# Started by rabbiz-session.service (ExecStart) as user `rabbiz`.
# Picks the compositor by mode precedence:
#
#   --labwc > --de > $XDG_CONFIG_HOME/rabbiz-de/mode > /etc/rabbiz-de/enabled > labwc
#
# labwc mode: exec()s the unchanged labwc launcher.
# DE mode:    clears wlroots/Mesa overrides, sources the Rust-owned env
#             contract (`rabbiz-de env --shell`), runs `rabbiz-de` as a
#             child, watches wayland-0 + rabbiz-de.ready, updates the D-Bus
#             activation environment, then supervises the child:
#               exit 75   → immediate labwc fallback, no failure counted
#               other end → append to rabbiz-de.fail; 3 in 60 s → labwc;
#                           otherwise re-exec this script.
#             ≥60 s uptime after readiness truncates the fail file.
#
# Extra args after the mode flag are forwarded to rabbiz-de (e.g.
# --force-fail); they are ignored in labwc mode. --print-mode prints the
# resolved mode and exits without launching anything.

set -uo pipefail

LABWC_LAUNCHER=/usr/local/bin/rabbiz-labwc-session
DE_BIN=/usr/local/bin/rabbiz-de
FAIL_WINDOW_S=60
FAIL_LIMIT=3

# --- XDG base dirs ---------------------------------------------------------
export LANG="${LANG:-C.UTF-8}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export LIBSEAT_BACKEND=seatd

# One-time rename migration: ~/.config/a21s-shell → ~/.config/rabbiz-shell
# (prefs.json, desktop.json). Idempotent; the labwc launcher repeats it for
# direct invocations that bypass this selector.
if [ -d "$XDG_CONFIG_HOME/a21s-shell" ] && [ ! -e "$XDG_CONFIG_HOME/rabbiz-shell" ]; then
    mv "$XDG_CONFIG_HOME/a21s-shell" "$XDG_CONFIG_HOME/rabbiz-shell"
fi

MODE=""
PRINT_MODE=0
DE_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --labwc) MODE=labwc ;;
        --de) MODE=de ;;
        --print-mode) PRINT_MODE=1 ;;
        *) DE_ARGS+=("$1") ;;
    esac
    shift
done

if [ -z "$MODE" ]; then
    mode_file="$XDG_CONFIG_HOME/rabbiz-de/mode"
    if [ -r "$mode_file" ]; then
        read -r m < "$mode_file" || true
        case "$m" in
            de|labwc) MODE="$m" ;;
            *) echo "rabbiz-session: invalid mode '$m' in $mode_file — labwc" >&2 ;;
        esac
    fi
    if [ -z "$MODE" ] && [ -e /etc/rabbiz-de/enabled ]; then
        MODE=de
    fi
fi
[ -z "$MODE" ] && MODE=labwc

# --print-mode: report the resolved mode without launching anything (used by
# scripts/de_m1_check.sh to verify precedence).
if [ "$PRINT_MODE" = "1" ]; then
    echo "$MODE"
    exit 0
fi

if [ "$MODE" != "de" ]; then
    exec "$LABWC_LAUNCHER"
fi

# --- DE mode ---------------------------------------------------------------
FAIL_FILE="$XDG_RUNTIME_DIR/rabbiz-de.fail"
READY_FILE="$XDG_RUNTIME_DIR/rabbiz-de.ready"
SOCKET="$XDG_RUNTIME_DIR/wayland-0"

to_labwc() {
    echo "rabbiz-session: $1 — falling back to labwc" >&2
    # DE-mode env must not leak into labwc — a stale WAYLAND_DISPLAY makes
    # wlroots pick its wayland backend instead of DRM.
    unset WAYLAND_DISPLAY DISPLAY
    exec "$LABWC_LAUNCHER"
}

now_ms() { date +%s%3N 2>/dev/null || echo "$(( $(date +%s) * 1000 ))"; }

record_failure() {
    local cutoff=$(( $(now_ms) - FAIL_WINDOW_S * 1000 ))
    touch "$FAIL_FILE"
    # Prune entries older than the window, append this failure.
    awk -v c="$cutoff" 'NF && $1+0 > c' "$FAIL_FILE" > "$FAIL_FILE.tmp" || true
    now_ms >> "$FAIL_FILE.tmp"
    mv -f "$FAIL_FILE.tmp" "$FAIL_FILE"
    local n
    n=$(wc -l < "$FAIL_FILE" | tr -d ' ')
    [ "$n" -ge "$FAIL_LIMIT" ]
}

# Environment contract from the single Rust authority.
unset LD_PRELOAD DRI_PRIME __EGL_VENDOR_LIBRARY_FILENAMES WLR_RENDERER WLR_BACKENDS WLR_DRM_DEVICES
eval "$("$DE_BIN" env --shell)" || to_labwc "rabbiz-de env failed"

# OSK + input-source settings (best effort — gsettings may be absent).
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true 2>/dev/null || true
    gsettings set org.gnome.desktop.input-sources sources "[('xkb','us'),('xkb','th')]" 2>/dev/null || true
fi

rm -f "$READY_FILE" "$SOCKET"
echo "rabbiz-session: starting rabbiz-de $*" >&2
"$DE_BIN" run "${DE_ARGS[@]}" &
DE_PID=$!

# Wait for the compositor to create wayland-0 (5 s).
t=0
while [ ! -S "$SOCKET" ] && [ $t -lt 50 ]; do
    kill -0 "$DE_PID" 2>/dev/null || break
    sleep 0.1; t=$((t+1))
done
if [ ! -S "$SOCKET" ]; then
    wait "$DE_PID"; rc=$?
    [ "$rc" = "75" ] && to_labwc "rabbiz-de init failure (75)"
    record_failure && to_labwc "rabbiz-de failed $FAIL_LIMIT×${FAIL_WINDOW_S}s (no socket)"
    exec "$0" --de "${DE_ARGS[@]}"
fi
export WAYLAND_DISPLAY=wayland-0

# Wait for the first successful page flip (10 s) → rabbiz-de.ready.
t=0
while [ ! -f "$READY_FILE" ] && [ $t -lt 100 ]; do
    kill -0 "$DE_PID" 2>/dev/null || break
    sleep 0.1; t=$((t+1))
done
if [ ! -f "$READY_FILE" ]; then
    kill "$DE_PID" 2>/dev/null || true
    wait "$DE_PID"; rc=$?
    [ "$rc" = "75" ] && to_labwc "rabbiz-de init failure (75)"
    record_failure && to_labwc "rabbiz-de failed $FAIL_LIMIT×${FAIL_WINDOW_S}s (no ready)"
    exec "$0" --de "${DE_ARGS[@]}"
fi
READY_S=$(date +%s)

# Propagate the full session env to D-Bus activation + systemd --user. `--all`
# (not a hand-picked list) so D-Bus-activated apps, portal backends and
# GApplication helpers inherit the whole `env::EXPORTS` contract
# (QT_QPA_PLATFORM, MOZ_ENABLE_WAYLAND, GDK_DPI_SCALE, ELECTRON_OZONE_*, XKB_*)
# instead of only the desktop name — audit 2026-11-21 P0.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all 2>/dev/null || true
fi

# Standard XDG user dirs (Desktop/Documents/…) so portal FileChooser and GTK
# dialogs land on real folders on first use.
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update >/dev/null 2>&1 || true

# XDG Autostart: user agents (gnome-keyring secrets, mako, kdeconnect, …)
# launch like on every other desktop. Runs after ready so WAYLAND_DISPLAY +
# the session bus are guaranteed; once per boot (compositor restarts must not
# spawn duplicate agents).
if [ ! -e "$XDG_RUNTIME_DIR/rabbiz-autostart.done" ]; then
    touch "$XDG_RUNTIME_DIR/rabbiz-autostart.done"
    "$DE_BIN" autostart >/dev/null 2>&1 &
fi

# Supervise until the compositor exits.
wait "$DE_PID"; rc=$?

# ≥60 s of post-readiness uptime resets the crash counter.
if [ $(( $(date +%s) - READY_S )) -ge "$FAIL_WINDOW_S" ]; then
    : > "$FAIL_FILE"
fi

[ "$rc" = "0" ] && exit 0
[ "$rc" = "75" ] && to_labwc "rabbiz-de init failure (75)"
record_failure && to_labwc "rabbiz-de failed $FAIL_LIMIT×${FAIL_WINDOW_S}s (rc=$rc)"
echo "rabbiz-session: rabbiz-de exited rc=$rc — restarting" >&2
exec "$0" --de "${DE_ARGS[@]}"
