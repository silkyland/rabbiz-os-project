#!/bin/sh
# a21s-notes — launch KDE Marknote when installed, else Notes.qml.
if command -v marknote >/dev/null 2>&1; then
    exec env QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software QT_QUICK_CONTROLS_MOBILE=1 marknote "$@"
fi
export QML_IMPORT_PATH=/usr/share/a21s-shell
export QT_QUICK_BACKEND=software
exec quickshell -p /usr/share/a21s-shell/apps/notes/Notes.qml "$@"
