# Restrict fingerprint sensor and cellular modem boot/IPC device nodes (SEC-002, SEC-004).
KERNEL=="esfp0", OWNER="root", GROUP="root", MODE="0600"
KERNEL=="umts_boot0", OWNER="root", GROUP="root", MODE="0600"
KERNEL=="umts_*", KERNEL!="umts_boot0", OWNER="root", GROUP="uucp", MODE="0660"
ACTION=="add", SUBSYSTEM=="misc", KERNEL=="esfp0", RUN+="/bin/chmod 0600 /sys/kernel/a21s_fp/trigger_unlock /sys/kernel/a21s_fp/sleep_pin"
