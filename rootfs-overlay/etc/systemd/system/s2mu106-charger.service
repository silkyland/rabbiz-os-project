[Unit]
Description=S2MU106 charger enable (charge path + watchdog kick)
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/charger-up.sh
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
