# rabbiz-session.service — system unit for the rabbiz-shell phone session.
#
# Runs labwc (wlroots compositor) + Quickshell shell surfaces as user `rabbiz`
# directly on DRM/input via seatd — TTY-independent, no getty, no display
# manager. Mutually exclusive with steamos-session.service; switch with:
#
#   systemctl disable steamos-session.service
#   systemctl enable rabbiz-session.service
#
# (and the reverse to go back — both units stay installed and functional).
#
# Deployed to /etc/systemd/system/ by scripts/deploy_shell.sh.

[Unit]
Description=RabbizOS phone session (rabbiz-de, labwc fallback)
Documentation=man:labwc(1)
# Hard conflict: only one graphical session may own the seat at a time.
# Starting this unit stops steamos-session.service (and vice versa).
Conflicts=steamos-session.service
# Seat/device access comes from seatd; D-Bus for NetworkManager/BlueZ/Pipewire.
Wants=seatd.service dbus.service NetworkManager.service bluetooth.service
After=seatd.service dbus.service NetworkManager.service bluetooth.service
# User manager for rabbiz provides the user D-Bus session + systemd --user
# services (pipewire, xdg-desktop-portal). PAMName=login below creates
# /run/user/<uid> and starts user@<uid>.service dynamically via pam_systemd
# without hardcoding a UID (BOOT-005).
After=systemd-user-sessions.service

[Service]
Type=simple
User=rabbiz
# Supplementary groups so DRM/input/seat access works even if /etc/group
# entries for rabbiz are missing (seatd socket is group `seat`).
SupplementaryGroups=seat input video render audio
PAMName=login
Environment=LANG=C.UTF-8
Environment=XDG_SESSION_TYPE=wayland
# Force libseat onto the seatd backend (no logind seat-claim attempt).
Environment=LIBSEAT_BACKEND=seatd
# Toolkit env moved into the session launchers: rabbiz-session owns the
# rabbiz-de env contract (`rabbiz-de env --shell`); rabbiz-labwc-session owns
# the labwc toolkit variables. The unit stays compositor-agnostic.
ExecStart=/usr/local/bin/rabbiz-session
# Phone UX: if the compositor dies, bring the shell back instead of
# stranding the user on a black screen.
Restart=on-failure
RestartSec=2
TimeoutStopSec=10s
# pam_systemd (PAMName=login) moves the session into session-*.scope, so the
# compositor is NOT in this unit's cgroup and a plain stop orphans it while
# it still owns DRM/the seat. Reap strays on every stop.
ExecStopPost=-/usr/bin/pkill -x rabbiz-de
ExecStopPost=-/usr/bin/pkill -x labwc

[Install]
WantedBy=multi-user.target
# Pre-rename name kept as an alias so `systemctl ... a21s-phone-session.service`
# (old scripts, polkit, steamos handover) keeps working.
Alias=a21s-phone-session.service
