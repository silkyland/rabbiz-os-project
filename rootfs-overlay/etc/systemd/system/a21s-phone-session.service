# a21s-phone-session.service — system unit for the a21s-shell phone session.
#
# Runs labwc (wlroots compositor) + Quickshell shell surfaces as user `gamer`
# directly on DRM/input via seatd — TTY-independent, no getty, no display
# manager. Mutually exclusive with steamos-session.service; switch with:
#
#   systemctl disable steamos-session.service
#   systemctl enable a21s-phone-session.service
#
# (and the reverse to go back — both units stay installed and functional).
#
# Deployed to /etc/systemd/system/ by scripts/deploy_shell.sh.

[Unit]
Description=A21S Phone Shell session (labwc + Quickshell)
Documentation=man:labwc(1)
# Hard conflict: only one graphical session may own the seat at a time.
# Starting this unit stops steamos-session.service (and vice versa).
Conflicts=steamos-session.service
# Seat/device access comes from seatd; D-Bus for NetworkManager/BlueZ/Pipewire.
Wants=seatd.service dbus.service NetworkManager.service bluetooth.service
After=seatd.service dbus.service NetworkManager.service bluetooth.service
# User manager for gamer provides the user D-Bus session + systemd --user
# services (pipewire, xdg-desktop-portal). PAMName=login below also triggers
# it via pam_systemd; ordering here just avoids a startup race.
Wants=user@1001.service
After=user@1001.service systemd-user-sessions.service

[Service]
Type=simple
User=gamer
# Supplementary groups so DRM/input/seat access works even if /etc/group
# entries for gamer are missing (seatd socket is group `seat`).
SupplementaryGroups=seat input video render audio
PAMName=login
# /run/user/1001 + XDG_RUNTIME_DIR are normally created by pam_systemd, but
# set explicitly so the session never starts without a valid runtime dir.
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus
Environment=LANG=C.UTF-8
Environment=XDG_SESSION_TYPE=wayland
# Force libseat onto the seatd backend (no logind seat-claim attempt).
Environment=LIBSEAT_BACKEND=seatd
# Qt/toolkit env is NOT set here: a21s-session sources the rabbiz-de env
# contract (`rabbiz-de env --shell`) for the DE path, and a21s-phone-session
# exports its own for the labwc path. The unit owns only seat/runtime vars.
ExecStart=/usr/local/bin/a21s-session
# Phone UX: if the compositor dies, bring the shell back instead of
# stranding the user on a black screen.
Restart=on-failure
RestartSec=2
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
