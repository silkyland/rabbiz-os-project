[Unit]
Description=ABOX audio bring-up (Calliope DSP + SMA1303 + AUD3004X)
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/audio-up.sh
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
