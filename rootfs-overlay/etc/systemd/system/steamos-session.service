# steamos-session.service — dedicated SteamOS session (weston landscape
# + native ARM64 steam -gamepadui via dbus-run-session).
#
# This is the verified-working Steam path on the A21s — the ARM64 steam
# client's cefwebhelper asserts inside labwc's XWayland, so Steam is
# entered as a full session switch instead of an in-shell window.
#
# Conflicts=a21s-phone-session.service makes
#   systemctl start steamos-session.service
# stop the phone session atomically inside PID1 (safe when the caller is
# the phone shell itself — the job is already queued).
#
# ExecStopPost=a21s-return-phone hands the seat back to the phone shell
# whenever the session was entered via a21s-session-switch (marker file)
# — including weston/steam crashing (Restart=no on purpose: on a phone,
# falling back home beats a black screen).
#
# Deployed to /etc/systemd/system/ by scripts/deploy_shell.sh.

[Unit]
Description=SteamOS ARM64 Session (Weston Landscape + Native Steam)
After=seatd.service systemd-user-sessions.service
Requires=seatd.service
Conflicts=a21s-phone-session.service

[Service]
Type=simple
User=gamer
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/1001 && chown gamer:gamer /run/user/1001'
ExecStart=/usr/local/bin/steamos-session
ExecStopPost=/usr/local/bin/a21s-return-phone
Restart=no
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
