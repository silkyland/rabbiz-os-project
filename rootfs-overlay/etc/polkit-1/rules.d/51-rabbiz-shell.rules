// A21s phone shell: the only interactive user is `gamer`, and labwc has no polkit
// authentication agent (no gnome-shell/kwallet prompt). Without this rule every radio
// change from the shell fails with "Insufficient privileges": NetworkManager refuses
// `nmcli device wifi connect` and `nmcli connection load` (both verified on the device).
//
// Scope is deliberately NetworkManager only, and only for `gamer`. Everything else
// (systemd units, package management) keeps requiring authentication; the seat handover
// rule stays in 50-rabbiz-session.rules.
polkit.addRule(function(action, subject) {
    if (subject.user !== "gamer")
        return polkit.Result.NOT_HANDLED;
    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
