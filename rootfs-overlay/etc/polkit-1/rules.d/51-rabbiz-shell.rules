// A21s phone shell: the only interactive user is `rabbiz`, and labwc has no polkit
// authentication agent (no gnome-shell/kwallet prompt). Without this rule radio
// changes from the shell fail with "Insufficient privileges".
//
// Scope is strictly limited to an active local `rabbiz` session and an explicit
// allow-list of safe NetworkManager actions (SEC-005). Privileged actions such as
// settings.modify.system, settings.modify.global-dns, settings.modify.hostname,
// wifi.share.open, and GetSecrets are deliberately excluded.
polkit.addRule(function(action, subject) {
    if (subject.user !== "rabbiz" || !subject.active || !subject.local)
        return polkit.Result.NOT_HANDLED;
    var allowed = {
        "org.freedesktop.NetworkManager.network-control": true,
        "org.freedesktop.NetworkManager.enable-disable-wifi": true,
        "org.freedesktop.NetworkManager.enable-disable-wwan": true,
        "org.freedesktop.NetworkManager.enable-disable-network": true,
        "org.freedesktop.NetworkManager.settings.modify.own": true,
        "org.freedesktop.NetworkManager.wifi.scan": true
    };
    if (allowed[action.id] === true)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
