# labwc autostart for the a21s-shell phone session.
# Each line runs via /bin/sh -c after the Wayland display is up
# (WAYLAND_DISPLAY is already set for these children).
# Deployed to ~gamer/.config/labwc/autostart by scripts/deploy_shell.sh.

# Export session env into the user systemd/D-Bus activation environment so
# user services (pipewire, xdg-desktop-portal, notification clients) see
# the Wayland display.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP &

# The shell itself: status bar, home screen, shade, nav bar (layer-shell).
# The shell draws its own UI: keep it off the KDE platform theme / desktop QQC2 style.
a21s-shell &

# On-screen keyboard (optional — skip silently if not installed).
# Idempotent OSK defaults first: auto-show on text focus (im-v2 under
# labwc needs this key) and US + Thai (Kedmanee, squeekboard 'th'
# layout ships built-in) sources — the 🌐 key toggles between them.
command -v gsettings >/dev/null 2>&1 && {
  gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
  gsettings set org.gnome.desktop.input-sources sources "[('xkb','us'),('xkb','th')]"
} &
# a21s-osk (tools/a21s-osk) is the default keyboard; squeekboard stays as the fallback for
# images that do not ship the binary yet. Never start both: the seat accepts one input method.
if command -v a21s-osk >/dev/null 2>&1; then
  a21s-osk &
else
  command -v squeekboard >/dev/null 2>&1 && squeekboard &
fi
