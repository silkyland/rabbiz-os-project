<?xml version="1.0"?>
<!--
  labwc configuration for a21s-shell (Samsung Galaxy A21s phone session).

  Design: Android-style single-tasking — every app toplevel is maximized
  with no server-side decorations; the shell UI (status bar, home screen,
  shade, nav bar) is provided by Quickshell layer-shell surfaces. Panel is
  DSI-1, 720x1600 native portrait.

  Deployed to ~gamer/.config/labwc/rc.xml by scripts/deploy_shell.sh.
-->
<labwc_config>

  <core>
    <!-- Server-side decorations by default; the window rule below strips
         them from every toplevel anyway. gap 0: no wasted pixels. -->
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowLockOut>no</allowLockOut>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <!-- Immersive app space: the StatusBar hides whenever a toplevel is
       visible, so no top margin is reserved — apps draw edge-to-edge.
       The NavBar collapses to a 24px gesture strip while an app is open;
       keep exactly that much reserved so the strip never overlaps app
       content (its expanded 56px row draws over the app transiently).
       Applies to output DSI-1 only; takes effect for windows mapped
       after config load — restart the session or re-maximize existing
       windows after changing. -->
  <margin top="0" bottom="24" left="0" right="0" output="DSI-1"/>

  <placement>
    <policy>center</policy>
  </placement>

  <!-- Single workspace; the shell provides its own switcher via NavBar. -->
  <desktops>
    <names>
      <name>1</name>
    </names>
  </desktops>

  <theme>
    <!-- No real theme needed: decorations are off for all toplevels.
         Font only matters for labwc's OSD (e.g. window switcher). -->
    <cornerRadius>0</cornerRadius>
    <dropShadows>no</dropShadows>
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="OnScreenDisplay">
      <name>Noto Sans</name>
      <size>12</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <focus>
    <!-- Touch-driven: focus on activation only, raise focused window. -->
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>no</followMouseRequiresMovement>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <resize>
    <drawContents>yes</drawContents>
  </resize>

  <!-- Android single-tasking: EVERY toplevel (wayland + XWayland) maps
       maximized with no decorations, and is hidden from labwc's own
       switcher/taskbar (Quickshell's ToplevelManager drives the shell
       switcher instead). -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="no" skipTaskbar="no" skipWindowSwitcher="no">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>

  <!-- Touchscreen: naturalScroll is configured via <libinput><device>.
       mapToOutput pins touch input to the single internal panel. -->
  <touch deviceName="*">
    <mapToOutput>DSI-1</mapToOutput>
  </touch>

  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <left-handed>no</left-handed>
      <pointerSpeed>0.0</pointerSpeed>
      <accelProfile>flat</accelProfile>
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <middleEmulation>no</middleEmulation>
      <disableWhileTyping>no</disableWhileTyping>
    </device>
  </libinput>

  <!--
    Keyboard: phone sessions have no desktop shortcuts. labwc merges its
    compiled-in defaults, so explicitly neutralize the ones that could
    confuse the single-tasking model when a keyboard is attached, and keep
    a minimal set (window close + next-window for the shell switcher).
  -->
  <keyboard>
    <repeatRate>40</repeatRate>
    <repeatDelay>400</repeatDelay>
    <numlock>off</numlock>

    <!-- Neutralized defaults: no terminal/menu/workspace shortcuts. -->
    <keybind key="W-Return"><action name="None"/></keybind>
    <keybind key="W-Escape"><action name="None"/></keybind>
    <keybind key="W-space"><action name="None"/></keybind>
    <keybind key="W-A-Left"><action name="None"/></keybind>
    <keybind key="W-A-Right"><action name="None"/></keybind>
    <keybind key="A-Left"><action name="None"/></keybind>
    <keybind key="A-Right"><action name="None"/></keybind>
    <keybind key="A-Up"><action name="None"/></keybind>
    <keybind key="A-Down"><action name="None"/></keybind>
    <keybind key="W-d"><action name="None"/></keybind>

    <!-- Minimal kept binds (hardware-debug convenience only). -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- Volume keys are owned by volume-keys.py (evdev): it delays a lone press and cancels it when the
         press is part of the Power+Volume screenshot combo. A labwc bind here would change the volume
         immediately (and twice per press), so there is deliberately no XF86Audio* bind. -->
    <keybind key="Print">
      <action name="Execute" command="a21s-screenshot"/>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +10%"/>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 10%-"/>
    </keybind>
    <keybind key="XF86PowerOff">
      <action name="Execute" command="a21s-power-key toggle"/>
    </keybind>
  </keyboard>

  <!--
    Mouse: no desktop menus on empty-desktop clicks — the HomeScreen layer
    surface owns the wallpaper area. Unbind Root clicks and alt-drag
    window move/resize so a pointer can't break single-tasking.
  -->
  <mouse>
    <defaultScrollFactor>1.0</defaultScrollFactor>
    <context name="Root">
      <mousebind button="Left" action="Press"><action name="None"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="None"/></mousebind>
      <mousebind button="Right" action="Press"><action name="None"/></mousebind>
    </context>
    <context name="Client">
      <mousebind button="A-Left" action="Drag"><action name="None"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="None"/></mousebind>
      <mousebind button="A-Middle" action="Drag"><action name="None"/></mousebind>
    </context>
    <context name="Frame">
      <mousebind button="A-Left" action="Drag"><action name="None"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="None"/></mousebind>
    </context>
  </mouse>

</labwc_config>
