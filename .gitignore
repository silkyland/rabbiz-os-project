# Build & cloned upstream trees (anchored: bare `src/` would ignore every
# crates/*/src/ inside tools/)
/build/
/src/
/vendor/
/backups/

# rabbiz-de worktrees and Rust build artifacts
.worktrees/
tools/rabbiz-de/**/target/
tools/rabbiz-de/target-*/
tools/rabbiz-de/build/

# a21s-osk (M7.12): Rust build products (workspace + spike crates)
tools/a21s-osk/**/target/
tools/a21s-osk/spikes/*/Cargo.lock
# downloaded Unicode/CLDR sources for the emoji dataset (regenerated, not shipped)
tools/a21s-osk/data/raw/

# deep-plan working memory
docs/.deep-plan/

# Editor / OS
.DS_Store
*.swp

# Out-of-tree kernel module build artifacts
*.o
*.ko
*.mod
*.mod.c
.*.cmd
Module.symvers
modules.order
.tmp_versions/


# A21s Mirror: SwiftPM build products, cached device packages, bundled .app
tools/a21s-mirror/.build/
tools/a21s-mirror/.cache/
dist/

# Python bytecode
__pycache__/
*.py[cod]
