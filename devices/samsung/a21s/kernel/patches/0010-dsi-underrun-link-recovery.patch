Subject: [PATCH] drm/exynos850-dsi: restart the video link on underrun

A single DSIM_INT_UNDER_RUN at compositor teardown desyncs the
video-mode link for good: the next atomic commit then times out waiting
for vblank and the panel stays black until reboot. Schedule a work item
on the underrun IRQ that, holding the transfer lock and gated on the
link still being enabled, runs dsim850_stop -> dsim850_init_link ->
dsim850_start to resynchronise the link in place.
diff --git a/drivers/gpu/drm/exynos/exynos850_drm_dsi.c b/drivers/gpu/drm/exynos/exynos850_drm_dsi.c
index d6927341f..8226b16c9 100644
--- a/drivers/gpu/drm/exynos/exynos850_drm_dsi.c
+++ b/drivers/gpu/drm/exynos/exynos850_drm_dsi.c
@@ -18,6 +18,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
+#include <linux/workqueue.h>
 
 #include <video/mipi_display.h>
 
@@ -304,6 +305,8 @@ struct dsim850 {
 	bool enabled;
 	/* left running by the bootloader, adopt it on the first enable */
 	bool boot_on;
+	/* restarts the video link after an underrun */
+	struct work_struct underrun_work;
 };
 
 static inline struct dsim850 *bridge_to_dsim(struct drm_bridge *bridge)
@@ -790,6 +793,28 @@ static void dsim850_stop(struct dsim850 *dsim)
 			   EXYNOS850_MIPI_PHY_ENABLE, 0);
 }
 
+static void dsim850_underrun_recover(struct work_struct *work)
+{
+	struct dsim850 *dsim = container_of(work, struct dsim850,
+					    underrun_work);
+	int ret;
+
+	/* Serialise against command transfers and the disable path. */
+	guard(mutex)(&dsim->lock);
+
+	if (!dsim->enabled)
+		return;
+
+	dev_warn(dsim->dev, "underrun: restarting video link\n");
+	dsim850_stop(dsim);
+	ret = dsim850_init_link(dsim);
+	if (ret) {
+		dev_err(dsim->dev, "underrun: link init failed: %d\n", ret);
+		return;
+	}
+	dsim850_start(dsim);
+}
+
 static irqreturn_t dsim850_irq_handler(int irq, void *dev_id)
 {
 	struct dsim850 *dsim = dev_id;
@@ -801,8 +826,11 @@ static irqreturn_t dsim850_irq_handler(int irq, void *dev_id)
 
 	dsim_write(dsim, DSIM_INTSRC, status);
 
-	if (status & DSIM_INT_UNDER_RUN)
+	if (status & DSIM_INT_UNDER_RUN) {
 		dev_err_ratelimited(dsim->dev, "underrun\n");
+		if (dsim->enabled)
+			schedule_work(&dsim->underrun_work);
+	}
 	if (status & DSIM_INT_INVALID_SFR_VALUE)
 		dev_err_ratelimited(dsim->dev, "invalid SFR value\n");
 	if (status & DSIM_INT_ERR_RX_ECC)
@@ -1203,6 +1231,8 @@ static int dsim850_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	INIT_WORK(&dsim->underrun_work, dsim850_underrun_recover);
+
 	dsim->regs = devm_platform_ioremap_resource_byname(pdev, "dsim");
 	if (IS_ERR(dsim->regs))
 		return PTR_ERR(dsim->regs);
@@ -1309,6 +1339,7 @@ static void dsim850_remove(struct platform_device *pdev)
 {
 	struct dsim850 *dsim = platform_get_drvdata(pdev);
 
+	cancel_work_sync(&dsim->underrun_work);
 	mipi_dsi_host_unregister(&dsim->host);
 	pm_runtime_disable(&pdev->dev);
 }
