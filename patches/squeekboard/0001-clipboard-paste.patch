diff --git a/src/clipboard.rs b/src/clipboard.rs
new file mode 100644
index 0000000..465d095
--- /dev/null
+++ b/src/clipboard.rs
@@ -0,0 +1,19 @@
+//! Clipboard helper (RabbizOS patch).
+//!
+//! squeekboard's protocol surface cannot read the clipboard, so the `paste` key action reads it
+//! through wl-clipboard (`wl-paste`) and submits the text like typed input. Returns None when the
+//! clipboard is empty, holds no text, or wl-paste is missing — the key then does nothing.
+
+use std::process::Command;
+
+pub fn read_text() -> Option<String> {
+    let out = Command::new("wl-paste")
+        .args(["-n", "-t", "text/plain;charset=utf-8"])
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&out.stdout).trim_end_matches(['\n', '\r']).to_string();
+    if text.is_empty() { None } else { Some(text) }
+}
