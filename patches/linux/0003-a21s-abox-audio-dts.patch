+/*
+ * ABOX sound card — codec links left without sound-dai so the machine
+ * driver falls back to snd-soc-dummy until the aud3004x speedy/acpm
+ * bus is ported.  Digital path CPU->ABOX DSP is fully exercised.
+ */
+/ {
+	sound {
+	compatible = "samsung,exynos3830-madera";
+
+	rdma0 {
+		cpu { sound-dai = <&abox_rdma0 0>; };
+		platform { sound-dai = <&abox 0>; };
+	};
+
+	rdma1 {
+		cpu { sound-dai = <&abox_rdma1 0>; };
+		platform { sound-dai = <&abox 0>; };
+	};
+
+	rdma2 {
+		cpu { sound-dai = <&abox_rdma2 0>; };
+		platform { sound-dai = <&abox 0>; };
+	};
+
+	rdma3 {
+		cpu { sound-dai = <&abox_rdma3 0>; };
+		platform { sound-dai = <&abox 0>; };
+	};
